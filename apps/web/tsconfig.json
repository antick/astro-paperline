{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": "src",
    "paths": {
      "@assets/*": ["assets/*"],
      "@config": ["config.ts"],
      "@components/*": ["components/*"],
      "@constants/*": ["constants/*"],
      "@content/*": ["content/*"],
      "@data/*": ["data/*"],
      "@layouts/*": ["layouts/*"],
      "@pages/*": ["pages/*"],
      "@settings": ["settings.ts"],
      "@styles/*": ["styles/*"],
      "@utils/*": ["utils/*"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "**/node_modules/*", ".vscode", "dist"]
}
