---
import Footer from '@components/Footer.astro';
import Navbar from '@components/navbar.astro';
import DemoBanner from '@components/DemoBanner.astro';
import { SITE_SETTINGS } from '@settings';
import '../styles/base.css';
import '../styles/demo-banner.css';
import '../styles/article.css';
import '../styles/navigation.css';
import '../styles/branding.css';
import '../styles/footer.css';
import { checkImageUrl } from '@utils/all';
import { SEO } from 'astro-seo';
import Analytics from '@vercel/analytics/astro';
import { SITE, UI, LOCALE } from '../config';
import type { ImageMetadata } from 'astro';

export interface Props {
  title?: string;
  seoTitle?: string;
  desc?: string;
  canonicalUrl?: string;
  ogImage?: string | ImageMetadata;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  socialCardType?: 'summary' | 'summary_large_image';
  robots?: { index: boolean; follow: boolean };
  language?: string;
  openGraphType?: string;
  publishedTime?: string;
  modifiedTime?: string;
  authorUrls?: string[];
  section?: string;
  tags?: string[];
  structuredData?: Record<string, unknown>;
}

const {
  title,
  seoTitle,
  desc,
  canonicalUrl,
  ogImage = SITE.ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  socialCardType = 'summary_large_image',
  robots = { index: true, follow: true },
  language = LOCALE.language,
  openGraphType = 'website',
  publishedTime,
  modifiedTime,
  authorUrls,
  section,
  tags,
  structuredData
} = Astro.props;
const resolvedCanonicalUrl = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOGImage = checkImageUrl(
  typeof ogImage === 'string' ? ogImage : ogImage.src,
  Astro.site
);
const resolvedTitle = seoTitle ?? (title ? `${title} | ${SITE.title}` : `${SITE.title} Blog`);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline src="/toggle-theme.js"></script>
    <Analytics />
    <SEO
      title={resolvedTitle}
      description={desc || SITE.desc}
      canonical={resolvedCanonicalUrl}
      noindex={!robots.index}
      nofollow={!robots.follow}
      openGraph={{
        basic: {
          url: resolvedCanonicalUrl,
          type: openGraphType,
          title: resolvedTitle,
          image: resolvedOGImage.toString()
        },
        optional: {
          description: desc || SITE.desc,
          siteName: SITE.title
        },
        image: {
          alt: ogImageAlt ?? (title ? `${title} cover image` : `${SITE.title} cover image`),
          width: ogImageWidth,
          height: ogImageHeight
        },
        article:
          openGraphType === 'article'
            ? {
                publishedTime,
                modifiedTime,
                authors: authorUrls,
                section,
                tags
              }
            : undefined
      }}
      twitter={{
        card: socialCardType,
        title: resolvedTitle,
        description: desc || SITE.desc,
        image: resolvedOGImage,
        imageAlt: ogImageAlt
      }}
    />
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {UI.skipToContent}
    </a>
    {SITE_SETTINGS.features.demoBanner && <DemoBanner />}
    <Navbar />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
