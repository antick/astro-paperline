---
import { TEMPLATE_DEMO } from '@config';
import RepositoryLink from './RepositoryLink.astro';
---

<aside
  id="demo-banner"
  class="demo-banner"
  aria-label={TEMPLATE_DEMO.bannerLabel}
  data-dismiss-key={TEMPLATE_DEMO.storageKey}
>
  <div class="demo-banner-content">
    <p>{TEMPLATE_DEMO.message}</p>
    <RepositoryLink class="demo-banner-link" label={TEMPLATE_DEMO.linkLabel} />
  </div>
  <button type="button" class="demo-banner-dismiss" aria-label={TEMPLATE_DEMO.dismissLabel} hidden>
    <svg aria-hidden="true" viewBox="0 0 24 24">
      <path d="m6 6 12 12M6 18 18 6" />
    </svg>
  </button>
  <script is:inline>
    (() => {
      const banner = document.currentScript.parentElement;
      const button = banner.querySelector('button');
      const storageKey = banner.dataset.dismissKey;
      try {
        banner.hidden = sessionStorage.getItem(storageKey) === 'true';
      } catch {
        // The banner can still be dismissed when browser storage is unavailable.
      }
      button.hidden = false;
      button.addEventListener('click', () => {
        banner.hidden = true;
        document.querySelector('.site-header .brand')?.focus({ preventScroll: true });
        try {
          sessionStorage.setItem(storageKey, 'true');
        } catch {
          // Keep dismissal working on this page without storage.
        }
      });
    })();
  </script>
</aside>
